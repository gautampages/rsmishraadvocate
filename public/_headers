# ============================================================================
#  Cloudflare Workers Assets — response headers.
#
#  Two jobs here, both of which show up in search ranking:
#
#  1. Caching. Vite fingerprints everything under /assets/, so those files can
#     be cached for a year and never revalidated. HTML must NOT be, or a
#     visitor keeps yesterday's page after a deploy.
#  2. Security headers. Not a ranking factor on their own, but they are what
#     a site-audit tool flags, and HSTS in particular protects the redirect
#     chain that link equity flows through.
#
#  Rules are matched most-specific-first, so /assets/* wins over /*.
# ============================================================================

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/checklists/*.pdf
  Cache-Control: public, max-age=86400
  X-Robots-Tag: index, follow

/*.jpg
  Cache-Control: public, max-age=604800

/*.svg
  Cache-Control: public, max-age=604800

/sitemap.xml
  Cache-Control: public, max-age=3600

/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
