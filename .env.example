# =============================================================================
# Optional overrides. The site works with none of these set.
#
# Both the court-records API and the AI assistant are fronted by Cloudflare
# workers that hold their credentials server-side, so no API key or token is
# ever sent from the browser and nothing secret belongs in this file.
#
# Copy to `.env.local` (git-ignored) only if you need to point the site at a
# different backend, then restart `npm run dev`.
# =============================================================================

# Court records (Case Status tracker).
# Production default: https://legal-data.gautampages.workers.dev/api
# In `npm run dev` this is ignored in favour of the /api/ecourts proxy defined
# in vite.config.js, because the worker's CORS header names a fixed hostname.
# VITE_ECOURTS_BASE_URL=https://legal-data.gautampages.workers.dev/api

# AI legal assistant (chat).
# Production default: https://cold-disk-f361.gautampages.workers.dev/
# VITE_ASSISTANT_URL=https://cold-disk-f361.gautampages.workers.dev/

# Appointments API — booking submission and the "you have an appointment"
# popup. Defaults to the production API, so this only needs setting to point
# at a staging environment.
# VITE_APPOINTMENTS_API=https://api.ramsnehimishra.in
